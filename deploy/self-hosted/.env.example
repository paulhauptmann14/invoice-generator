# Copy of the keys scripts/setup writes to .env (mode 600, git-ignored). Normally you never create this by hand:
# run scripts/setup, it generates the secrets.

# Name or address people type in the browser; must resolve to this machine (e.g. via the router or mDNS)
APP_HOST=rechnungen.local
# Published ports of the reverse proxy (the only ports the stack opens)
HTTP_PORT=80
HTTPS_PORT=443

# Generated secrets
POSTGRES_PASSWORD=
# 64 hex characters
JWT_SECRET=
# HS256 JWTs signed with JWT_SECRET (roles anon / service_role); the app only receives the anon key
ANON_KEY=
SERVICE_ROLE_KEY=
JWT_EXPIRY=3600

# Backups are OFF until you turn them on (README, chapter "Turn on backups"): BACKUPS=on|off. Off means: the nightly timer
# does nothing, update and restore skip their automatic backup. A manual `scripts/backup` always works. A .env without this
# line counts as on.
BACKUPS=off
# Backup directory (relative to deploy/self-hosted or absolute) and the optional age public key that encrypts the backups.
# Leave AGE_RECIPIENT empty for unencrypted backups (*.tar). Set an age1... key before backups go to an external disk; the
# matching private key must stay off this machine. The AGE_RECIPIENT line must stay in the file.
BACKUP_DIR=./backups
AGE_RECIPIENT=

# Self-registration: REGISTRATION=on|off. On: the login page offers "Konto anlegen", anyone who can reach the app may create an
# account and gets an empty workspace of their own (accounts never see each other's businesses). Off: no registration page and
# GoTrue rejects sign-ups; accounts are created by scripts/setup only. setup writes on for new installs; a .env without this line
# counts as off. Change it, then run `docker compose up -d` (the app and the auth service pick it up).
REGISTRATION=on

COMPOSE_PROJECT_NAME=rechnungen
