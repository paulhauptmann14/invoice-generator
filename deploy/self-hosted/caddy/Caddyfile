# TLS of the public site, chosen by TLS_MODE in .env (missing = internal); import tls_<mode> below picks the snippet:
#   internal  Caddy's own CA (install the root certificate once per device: scripts/cert)
#   duckdns   Let's Encrypt certificate for the DuckDNS name in APP_HOST via the DNS challenge (README, "Trusted certificate with
#             DuckDNS"). {env.DUCKDNS_TOKEN} is resolved at run time, so the token is neither logged nor stored in Caddy's saved config.
(tls_internal) {
	tls internal
}
(tls_duckdns) {
	tls {
		dns duckdns {env.DUCKDNS_TOKEN}
	}
}

# Public site: the invoice app over HTTPS.
{$APP_HOST} {
	import tls_{$TLS_MODE:internal}
	encode zstd gzip
	reverse_proxy app:3000
}

# Internal gateway for the Supabase services; not published to the host, only reachable inside the Compose network.
:8000 {
	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}
	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}
	handle_path /storage/v1/* {
		reverse_proxy storage:5000
	}
	respond 404
}
