# Public site: the invoice app over HTTPS with Caddy's internal CA (install the root certificate once per device: scripts/cert).
{$APP_HOST} {
	tls internal
	encode zstd gzip
	reverse_proxy app:3000
}

# Internal gateway for the Supabase services; not published to the host, only reachable inside the Compose network.
:8000 {
	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}
	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}
	handle_path /storage/v1/* {
		reverse_proxy storage:5000
	}
	respond 404
}
