#!/usr/bin/env bash
# Updates the app: backup first, then new code, a new app image (and Caddy image with TLS_MODE=duckdns), database migrations and a restart of the app.
#
#   update              git pull (fast-forward only), then as above
#   update --no-pull    skip git pull (tests, or code you updated yourself)
#   update --no-backup  skip the backup before the migrations (only if you know the data is safe elsewhere)
#
# The backup comes first and is never skipped silently. With BACKUPS=on it is the regular backup; with BACKUPS=off (no external
# disk yet) it is a local copy rechnungen-preupdate-*.tar[.age] in the backup directory, of which the newest two are kept (the
# nightly timer stays off). If the backup fails, nothing is changed. To go back after a bad update see the README, "Update went
# wrong".
#
# The running app keeps serving until the new images are built. The .env certificate settings are checked first. The build comes before the migrations, so a failed backup, pull
# or build changes neither the running app nor the database. A failed migration is rolled back (one transaction per file) and
# the old app keeps running: do not restore the backup, fix the cause and run update again. At the end, Caddy reloads its
# Caddyfile and old images and build cache are removed.
set -euo pipefail

main() {
  # shellcheck source=lib/common.sh
  . "$(dirname "${BASH_SOURCE[0]}")/lib/common.sh"
  local scripts pull=1 backup=1 arg
  scripts="$(dirname "${BASH_SOURCE[0]}")"
  for arg in "$@"; do
    case "$arg" in
      --no-pull) pull=0 ;;
      --no-backup) backup=0 ;;
      *) die "usage: update [--no-pull] [--no-backup]" ;;
    esac
  done

  # Before anything is changed (backup, pull, build): a .env with inconsistent certificate settings stops here.
  validate_tls_env

  if [ "$backup" = 0 ]; then
    info "Skipping the backup (--no-backup)."
  elif backups_enabled; then
    info "Backing up before the update ..."
    "$scripts/backup" || die "the backup failed; nothing was changed"
  else
    info "Backups are off - making a local copy before the update (kept: the newest two) ..."
    "$scripts/backup" --pre-update || die "the backup failed; nothing was changed (use --no-backup to update without one)"
  fi

  if [ "$pull" = 1 ]; then
    info "Fetching the new version ..."
    git -C "$REPO_DIR" pull --ff-only
  fi

  # Caddy is built only with TLS_MODE=duckdns (its image then comes from caddy.Dockerfile, see compose.duckdns.yml); otherwise it is
  # the plain official image, which needs no build. Docker's layer cache makes the build a quick no-op unless the Dockerfile changed.
  if [ "$(env_get TLS_MODE internal)" = duckdns ]; then
    info "Building the new app and Caddy images (the old app keeps running meanwhile) ..."
    compose build app caddy
  else
    info "Building the new app image (the old app keeps running meanwhile) ..."
    compose build app
  fi

  info "Applying database migrations ..."
  "$scripts/migrate"

  # All services: compose recreates only those whose image, compose.yml entry or .env values changed (e.g. a new
  # REGISTRATION value for auth); unchanged ones keep running.
  compose up -d
  # Caddy too: compose may just have recreated it (changed mount or image), and a reload needs it running.
  wait_healthy app caddy

  # Caddy reads its Caddyfile at start only, and an update may have changed it: reload (no downtime, a broken file is refused
  # and the old one keeps running).
  info "Reloading the Caddy configuration ..."
  compose exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile ||
    die "Caddy reload failed: the new Caddyfile was refused (Caddy keeps the old one) or Caddy is not running; see the message above"

  # Every build leaves the previous app image behind (dangling) and adds build cache; on an SD card that adds up. Only
  # images no container uses and cache older than a week are removed, never volumes. A failure here must not fail the update.
  info "Removing old images and build cache ..."
  docker image prune -f >/dev/null || info "(could not remove old images; ignored)"
  docker builder prune -f --filter until=168h >/dev/null || info "(could not remove old build cache; ignored)"
  info "Update finished."
}

# git pull may replace this very file; bash reads scripts while running them, so everything is inside main and we exit here.
main "$@"
exit
