#!/usr/bin/env bash
# Backup of everything that is not in git: the database (data only), the storage files, Caddy's certificate authority and
# the .env file. Prunes old backups afterwards. The app keeps running.
#
# With AGE_RECIPIENT set in .env the archive is encrypted: $BACKUP_DIR/rechnungen-YYYY-MM-DD-HHMM.tar.age, readable only with
# the private age key that belongs to it. With AGE_RECIPIENT empty it is written as plain $BACKUP_DIR/rechnungen-YYYY-MM-DD-HHMM.tar
# (readable by the owner only, file mode 600) and a warning says so. Pruning counts both kinds together.
#
# The archive also holds migrations.txt (the applied migration versions) and commit.txt (git commit of this checkout), so a
# restore knows which schema the data belongs to.
#
#   backup           regular backup, followed by pruning. Always works, also with BACKUPS=off in .env (an explicit command; it is
#                    how data is moved to a new machine)
#   backup --if-enabled  the same, but does nothing (exit 0, one message) when .env says BACKUPS=off; the nightly timer uses this
#   backup --safety  the safety copy that restore makes of the current data: named rechnungen-safety-YYYY-MM-DD-HHMM.tar.age
#                    (or .tar), never pruned and not counted by pruning, so it can neither delete nor crowd out a real backup
set -euo pipefail

# shellcheck source=lib/common.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/common.sh"

KEEP_RECENT=14
KEEP_MONTHS=12
# A Raspberry Pi has no battery-backed clock: before the network time arrives it can believe it is 1970 or 2024.
# Such a backup would get a misleading name and could be pruned as "old", so we refuse to run.
MIN_YEAR=2026
# How long to wait for another backup (timer and update can overlap) before giving up
LOCK_TIMEOUT="${BACKUP_LOCK_TIMEOUT:-600}"

SAFETY=0
IF_ENABLED=0
for arg in "$@"; do
  case "$arg" in
    --safety) SAFETY=1 ;;
    --if-enabled) IF_ENABLED=1 ;;
    *) die "usage: backup [--if-enabled] [--safety]" ;;
  esac
done

[ -f "$ENV_FILE" ] || die "$ENV_FILE does not exist (run setup first)"
if [ "$IF_ENABLED" = 1 ] && ! backups_enabled; then
  info "Backups are off (BACKUPS=off in $ENV_FILE); nothing was done. To switch them on see the README, chapter 'Turn on backups'."
  exit 0
fi

for tool in docker tar; do
  command -v "$tool" >/dev/null 2>&1 || die "'$tool' is required but not installed"
done
# Empty means: no encryption.
recipient="$(env_get AGE_RECIPIENT)"
if [ -n "$recipient" ]; then
  [[ "$recipient" =~ ^age1[a-z0-9]+$ ]] || die "AGE_RECIPIENT in $ENV_FILE is not an age public key (it must start with age1, or be empty for unencrypted backups)"
  command -v age >/dev/null 2>&1 || die "'age' is required for encrypted backups but not installed (install it, or leave AGE_RECIPIENT empty)"
fi

year="$(date +%Y)"
[[ "$year" =~ ^[0-9]{4}$ ]] && [ "$year" -ge "$MIN_YEAR" ] || die "the system clock says year '$year'; refusing to back up with a clock that is clearly wrong (wait for the time sync, or set the date)"

umask 077
dest_dir="$(backup_dir)"
mkdir -p "$dest_dir"

work="$(mktemp -d)"
partial=""
lock_dir=""
# Any failure removes the work files and the partly written archive, so a backup file is either complete or absent.
cleanup() {
  rm -rf "${work:?}"
  if [ -n "$partial" ]; then
    rm -f "$partial"
  fi
  if [ -n "$lock_dir" ]; then
    rm -rf "$lock_dir"
  fi
}
trap cleanup EXIT

# One backup at a time per backup directory; a second one waits up to LOCK_TIMEOUT seconds. flock (util-linux, on the Pi)
# releases the lock even if the process is killed. Without flock (macOS) a lock directory with the owner's PID is used.
acquire_lock() {
  local waited=0 owner
  if command -v flock >/dev/null 2>&1; then
    exec 9>"$dest_dir/.backup.lock"
    flock -w "$LOCK_TIMEOUT" 9 || die "another backup has been running for more than $LOCK_TIMEOUT seconds; nothing was done"
    return
  fi
  until mkdir "$dest_dir/.backup.lock.d" 2>/dev/null; do
    owner="$(cat "$dest_dir/.backup.lock.d/pid" 2>/dev/null || true)"
    if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then
      rm -rf "$dest_dir/.backup.lock.d" # the owner died without cleaning up
      continue
    fi
    [ "$waited" -lt "$LOCK_TIMEOUT" ] || die "another backup has been running for more than $LOCK_TIMEOUT seconds; nothing was done"
    sleep 1
    waited=$((waited + 1))
  done
  lock_dir="$dest_dir/.backup.lock.d"
  echo $$ >"$lock_dir/pid"
}

# Formats an epoch second like date +%Y-%m-%d-%H%M (GNU date, then BSD date).
stamp() { # stamp <epoch>
  date -d "@$1" +%Y-%m-%d-%H%M 2>/dev/null || date -r "$1" +%Y-%m-%d-%H%M
}

# Keeps the newest KEEP_RECENT backups plus the newest backup of each of the last KEEP_MONTHS calendar months (counted back from
# the current one). Encrypted (.tar.age) and unencrypted (.tar) backups are counted together. Only files named like our
# backups are touched (not the safety copies). Works on the timestamp in the name, no date arithmetic.
prune() { # prune <dir> <file name that must stay>
  local dir=$1 protected=$2 file name month seen=" " position=0 month_index cutoff keep
  cutoff=$(( 10#$(date +%Y) * 12 + 10#$(date +%m) - KEEP_MONTHS ))
  # Newest first (names sort chronologically).
  while IFS= read -r file; do
    name="$(basename "$file")"
    [[ "$name" =~ ^rechnungen-([0-9]{4})-([0-9]{2})-[0-9]{2}-[0-9]{4}\.tar(\.age)?$ ]] || continue
    position=$((position + 1))
    month="${BASH_REMATCH[1]}-${BASH_REMATCH[2]}"
    month_index=$(( 10#${BASH_REMATCH[1]} * 12 + 10#${BASH_REMATCH[2]} ))
    keep=0
    if [ "$position" -le "$KEEP_RECENT" ]; then
      keep=1
    fi
    # The first file seen for a month is the newest one of that month.
    if [[ "$seen" != *" $month "* ]]; then
      seen="$seen$month "
      if [ "$month_index" -gt "$cutoff" ]; then
        keep=1
      fi
    fi
    # Never delete the backup this run just made, whatever its name says (a wrong clock must not make it look old).
    if [ "$keep" = 0 ] && [ "$name" != "$protected" ]; then
      rm -f "$file"
      info "Removed old backup $name"
    fi
  done < <(find "$dir" -maxdepth 1 -type f \( -name 'rechnungen-*.tar.age' -o -name 'rechnungen-*.tar' \) | LC_ALL=C sort -r)
}

acquire_lock

# After a power cut the timer's catch-up run can start before the database is up.
wait_healthy db

info "Dumping the database ..."
# Tables the database owner cannot write (see lib/common.sh) are dumped without data.
skip_list="$(psql_admin -qtA -c "$DATA_TABLES_SQL except $WRITABLE_TABLES_SQL")"
skip_args=()
while IFS= read -r table; do
  [ -z "$table" ] || skip_args+=("--exclude-table-data=$table")
done <<<"$skip_list"
compose exec -T db pg_dump -U postgres --data-only --schema=public --schema=private --schema=auth --schema=storage \
  --exclude-table=auth.schema_migrations --exclude-table=storage.migrations ${skip_args[@]+"${skip_args[@]}"} >"$work/data.sql"
[ -s "$work/data.sql" ] || die "the database dump is empty"
psql_admin -qtA -c 'select version from supabase_migrations.schema_migrations order by version' >"$work/migrations.txt"
[ -s "$work/migrations.txt" ] || die "the list of applied migrations is empty (was migrate ever run?)"
{ git -C "$REPO_DIR" rev-parse HEAD 2>/dev/null || echo unknown; } >"$work/commit.txt"

info "Archiving storage files and certificate authority ..."
volume_to_tar storage-data >"$work/storage.tar"
volume_to_tar caddy-data >"$work/caddy.tar"
cp "$ENV_FILE" "$work/.env"

# Names carry the minute; a backup in the same minute as an earlier one gets the next free minute instead of replacing it.
name_prefix=rechnungen
if [ "$SAFETY" = 1 ]; then
  name_prefix=rechnungen-safety
fi
extension=tar
if [ -n "$recipient" ]; then
  extension=tar.age
fi
epoch="$(date +%s)"
# A minute is taken when a backup of either kind has it, so the timestamps in the names stay unique.
while [ -e "$dest_dir/$name_prefix-$(stamp "$epoch").tar" ] || [ -e "$dest_dir/$name_prefix-$(stamp "$epoch").tar.age" ]; do
  epoch=$((epoch + 60))
done
name="$name_prefix-$(stamp "$epoch").$extension"
partial="$(mktemp "$dest_dir/.partial.XXXXXX")" # created with mode 600 (umask 077)
if [ -n "$recipient" ]; then
  tar -C "$work" -cf - data.sql storage.tar caddy.tar .env migrations.txt commit.txt | age -r "$recipient" >"$partial"
else
  tar -C "$work" -cf "$partial" data.sql storage.tar caddy.tar .env migrations.txt commit.txt
fi
mv "$partial" "$dest_dir/$name"
partial=""
info "Backup written: $dest_dir/$name ($(wc -c <"$dest_dir/$name" | tr -d ' ') bytes)"
if [ -z "$recipient" ]; then
  # A backup directory outside this installation is probably an external disk: anyone who plugs it in can read the backup
  # (file modes mean nothing on exFAT, NTFS and FAT).
  case "$dest_dir/" in
    "$DEPLOY_DIR"/*) echo "warning: this backup is NOT encrypted (AGE_RECIPIENT in $ENV_FILE is empty); set a key before backups go to an external disk" >&2 ;;
    *) echo "warning: this backup is NOT encrypted and $dest_dir is outside this installation (an external disk?): anyone who can plug that disk in can read it; set AGE_RECIPIENT in $ENV_FILE first" >&2 ;;
  esac
fi

if [ "$SAFETY" = 0 ]; then
  prune "$dest_dir" "$name"
fi
