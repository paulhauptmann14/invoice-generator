#!/usr/bin/env bash
# First-time setup: creates .env with fresh secrets, starts the stack, applies migrations, creates the owner account and
# the first business, builds and starts the app. Safe to re-run: an existing .env and an existing account are kept.
#
#   setup            full setup (asks for what is not in the environment)
#   setup --restore  everything except account/business (data comes from a backup)
#   setup --restore --until <version>  same, but migrates only up to that version (restore loads the data first, then migrates the rest)
#
# Unattended runs can set APP_HOST, HTTP_PORT, HTTPS_PORT, COMPOSE_PROJECT_NAME, OWNER_EMAIL, OWNER_PASSWORD and
# TENANT_NAME in the environment. A new .env has BACKUPS=off (backups are switched on later, see README "Turn on backups")
# and an empty AGE_RECIPIENT (no backup encryption); setup never asks about either. A pre-set AGE_RECIPIENT in the
# environment is validated and written.
set -euo pipefail

# shellcheck source=lib/common.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/common.sh"
# shellcheck source=lib/jwt.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/jwt.sh"

RESTORE=0
MIGRATE_ARGS=()
USAGE="usage: setup [--restore [--until <version>]]"
case "${1:-}" in
  --restore)
    RESTORE=1
    case "${2:-}" in
      --until)
        [[ "${3:-}" =~ ^[0-9]+$ && $# -eq 3 ]] || die "$USAGE"
        MIGRATE_ARGS=(--until "$3")
        ;;
      "") ;;
      *) die "$USAGE" ;;
    esac
    ;;
  "") ;;
  *) die "$USAGE" ;;
esac

ask() { # ask <VARNAME> <prompt> [default]: keeps a value that is already set in the environment
  local name=$1 prompt=$2 default=${3:-} answer
  if [ -n "${!name:-}" ]; then
    return
  fi
  if [ ! -t 0 ]; then
    [ -n "$default" ] || die "$name is not set and there is no terminal to ask"
    printf -v "$name" '%s' "$default"
    return
  fi
  read -r -p "$prompt${default:+ [$default]}: " answer
  printf -v "$name" '%s' "${answer:-$default}"
}

check_prerequisites() {
  local tool
  for tool in docker openssl; do
    command -v "$tool" >/dev/null 2>&1 || die "'$tool' is required but not installed"
  done
  docker compose version >/dev/null 2>&1 || die "the Docker Compose plugin is required (docker compose)"
  docker info >/dev/null 2>&1 || die "cannot talk to the Docker daemon (is it running, are you in the docker group?)"
}

REQUIRED_ENV_KEYS="APP_HOST HTTP_PORT HTTPS_PORT POSTGRES_PASSWORD JWT_SECRET ANON_KEY SERVICE_ROLE_KEY JWT_EXPIRY BACKUP_DIR COMPOSE_PROJECT_NAME"
# The line must exist, the value may be empty (empty = unencrypted backups).
OPTIONAL_ENV_KEYS="AGE_RECIPIENT"

validate_env_file() {
  local key missing=""
  for key in $REQUIRED_ENV_KEYS; do
    [ -n "$(env_get "$key")" ] || missing="$missing $key"
  done
  for key in $OPTIONAL_ENV_KEYS; do
    grep -q "^$key=" "$ENV_FILE" || missing="$missing $key"
  done
  # BACKUPS may be missing (older .env files count as on), but a value must be on or off.
  if grep -q '^BACKUPS=' "$ENV_FILE"; then
    case "$(env_get BACKUPS)" in
      on | off) ;;
      *) die "BACKUPS must be 'on' or 'off' (found '$(env_get BACKUPS)' in $ENV_FILE)" ;;
    esac
  fi
  [ -z "$missing" ] || die "$ENV_FILE is incomplete (empty or missing:$missing). Fix it or delete it, then re-run setup; a deleted .env means new secrets."
}

create_env_file() {
  if [ -f "$ENV_FILE" ]; then
    validate_env_file
    info "Keeping the existing $ENV_FILE"
    return
  fi
  ask APP_HOST "Name the app is reached at on your network" "rechnungen.local"
  # No question about backups: they are off until the owner turns them on. An AGE_RECIPIENT given in the environment is kept.
  AGE_RECIPIENT="${AGE_RECIPIENT:-}"
  [[ "$APP_HOST" =~ ^[A-Za-z0-9.-]+$ ]] || die "APP_HOST may only contain letters, digits, dots and hyphens"
  if [ -n "$AGE_RECIPIENT" ]; then
    [[ "$AGE_RECIPIENT" =~ ^age1[a-z0-9]+$ ]] || die "AGE_RECIPIENT must be an age public key starting with age1 (or empty for unencrypted backups)"
    command -v age >/dev/null 2>&1 || die "'age' is required for encrypted backups but not installed (install it, or leave AGE_RECIPIENT empty)"
  fi
  local http_port=${HTTP_PORT:-80} https_port=${HTTPS_PORT:-443} project=${COMPOSE_PROJECT_NAME:-rechnungen}
  [[ "$http_port" =~ ^[0-9]+$ && "$https_port" =~ ^[0-9]+$ ]] || die "HTTP_PORT and HTTPS_PORT must be numbers"
  [[ "$project" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || die "COMPOSE_PROJECT_NAME may only contain lowercase letters, digits, hyphens and underscores"

  # Generate everything first: a failing command substitution inside a heredoc would silently write an empty secret.
  local postgres_password jwt_secret anon_key service_role_key
  postgres_password="$(openssl rand -hex 24)"
  jwt_secret="$(openssl rand -hex 32)"
  anon_key="$(jwt_hs256 anon "$jwt_secret")"
  service_role_key="$(jwt_hs256 service_role "$jwt_secret")"
  [ -n "$postgres_password" ] && [ -n "$jwt_secret" ] && [ -n "$anon_key" ] && [ -n "$service_role_key" ] || die "could not generate secrets (is openssl working?)"

  # Write a temp file next to the target and move it into place, so an interrupted run never leaves a partial .env.
  local tmp
  tmp="$(umask 077 && mktemp "$ENV_FILE.XXXXXX")"
  cat >"$tmp" <<ENV
APP_HOST=$APP_HOST
HTTP_PORT=$http_port
HTTPS_PORT=$https_port
POSTGRES_PASSWORD=$postgres_password
JWT_SECRET=$jwt_secret
ANON_KEY=$anon_key
SERVICE_ROLE_KEY=$service_role_key
JWT_EXPIRY=3600
BACKUP_DIR=${BACKUP_DIR:-./backups}
AGE_RECIPIENT=$AGE_RECIPIENT
BACKUPS=off
COMPOSE_PROJECT_NAME=$project
ENV
  mv "$tmp" "$ENV_FILE"
  validate_env_file
  info "Wrote $ENV_FILE (secrets generated, readable by you only). Keep a copy somewhere safe; backups include it."
}

create_owner() {
  local existing
  existing="$(psql_admin -qtA -c 'select count(*) from auth.users')"
  if [ "$existing" != 0 ]; then
    info "An account already exists; skipping account creation."
    return
  fi
  ask OWNER_EMAIL "E-mail address for the account"
  ask TENANT_NAME "Name of the business"
  read_password OWNER_PASSWORD "Password (at least 12 characters)"
  export OWNER_EMAIL TENANT_NAME
  # Values reach psql through the environment of the exec call, never through arguments.
  PSQL_PASS_ENV="OWNER_EMAIL OWNER_PASSWORD TENANT_NAME" psql_admin -q >/dev/null <<'SQL'
\getenv em OWNER_EMAIL
\getenv pw OWNER_PASSWORD
\getenv tn TENANT_NAME
select private.bootstrap_owner(:'em', :'pw', :'tn');
SQL
  unset OWNER_PASSWORD
  info "Created the account and the business."
}

check_prerequisites
create_env_file

info "Starting database and services ..."
compose up -d db auth rest storage caddy
# GoTrue and the storage API create their own tables on first start; our migrations depend on them.
wait_healthy db auth rest storage caddy

"$(dirname "${BASH_SOURCE[0]}")/migrate" ${MIGRATE_ARGS[@]+"${MIGRATE_ARGS[@]}"}

if [ "$RESTORE" = 0 ]; then
  create_owner
fi

info "Building and starting the app (the first build takes a few minutes) ..."
compose build app
compose up -d app
wait_healthy app

url="https://$(env_get APP_HOST)"
port="$(env_get HTTPS_PORT 443)"
if [ "$port" != 443 ]; then
  url="$url:$port"
fi
echo
echo "Done. Open $url in a browser."
echo "The browser warns about the certificate until you install the root certificate:"
echo "  $(dirname "${BASH_SOURCE[0]}")/cert   (writes ./rechnungen-root.crt; install it on every device)"
