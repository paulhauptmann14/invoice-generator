#!/usr/bin/env bash
# Applies the SQL files in supabase/migrations that the database has not seen yet and prints "<n> applied".
# Uses the same bookkeeping table as the Supabase CLI, so a database can move between the two.
#
#   migrate                   apply every pending file
#   migrate --until <version> apply only pending files up to and including that version (restore uses this to
#                             bring an empty database to the schema of an older backup before loading its data)
set -euo pipefail

# shellcheck source=lib/common.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/common.sh"

UNTIL=""
case "${1:-}" in
  --until)
    [[ "${2:-}" =~ ^[0-9]+$ ]] || die "usage: migrate [--until <version>]"
    UNTIL="$2"
    ;;
  "") ;;
  *) die "usage: migrate [--until <version>]" ;;
esac

psql_admin -q <<'SQL'
create schema if not exists supabase_migrations;
create table if not exists supabase_migrations.schema_migrations (
  version text primary key,
  name text,
  statements text[]
);
SQL

applied="$(psql_admin -qtA -c 'select version from supabase_migrations.schema_migrations')"
count=0
for file in "$MIGRATIONS_DIR"/*.sql; do
  base="$(basename "$file")"
  [[ "$base" =~ ^([0-9]+)_([A-Za-z0-9_.-]+)\.sql$ ]] || die "unexpected migration file name: $base"
  version="${BASH_REMATCH[1]}"
  name="${BASH_REMATCH[2]}"
  if grep -qx "$version" <<<"$applied"; then
    continue
  fi
  # Versions are fixed-width timestamps, so a string comparison orders them.
  if [ -n "$UNTIL" ] && [[ "$version" > "$UNTIL" ]]; then
    continue
  fi
  info "applying $base"
  # One transaction per file, with the bookkeeping row inside it: either both happen or neither.
  {
    cat "$file"
    printf "\ninsert into supabase_migrations.schema_migrations (version, name) values ('%s', '%s');\n" "$version" "$name"
  } | psql_admin -q --single-transaction -f - >/dev/null
  count=$((count + 1))
done
echo "$count applied"
