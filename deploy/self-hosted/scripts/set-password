#!/usr/bin/env bash
# Sets a new password for an existing account and signs it out everywhere: set-password <email>
set -euo pipefail

# shellcheck source=lib/common.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/common.sh"

[ $# -eq 1 ] || die "usage: set-password <email>"
OWNER_EMAIL="$1"
export OWNER_EMAIL

read_password NEW_PASSWORD "New password (at least 12 characters)"

# Values reach psql through the environment of the exec call, never through arguments.
PSQL_PASS_ENV="OWNER_EMAIL NEW_PASSWORD" psql_admin -q <<'SQL'
\getenv em OWNER_EMAIL
\getenv pw NEW_PASSWORD
select private.set_password(:'em', :'pw');
SQL
info "Password changed; the account was signed out everywhere."
