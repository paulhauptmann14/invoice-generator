#!/usr/bin/env bash
# Shows container state, free disk space and the newest backup.
set -euo pipefail

# shellcheck source=lib/common.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/common.sh"

if backups_enabled; then
  echo "Backups: on"
else
  echo "Backups: OFF (enable: see README 'Turn on backups')"
fi

dir="$(backup_dir)"
# With backups on, a backup older than this (the timer runs nightly) is a problem.
STALE_MINUTES=2880
if [ -e "$BACKUP_FAILED_MARKER" ]; then
  echo "WARNING: the nightly backup failed at $(date -r "$BACKUP_FAILED_MARKER" '+%Y-%m-%d %H:%M'). See: journalctl -u rechnungen-backup"
  echo "         (the warning goes away after the next successful backup)"
fi
if backups_enabled; then
  recent=""
  if [ -d "$dir" ]; then
    recent="$(find "$dir" -maxdepth 1 -type f \( -name 'rechnungen-[0-9]*.tar.age' -o -name 'rechnungen-[0-9]*.tar' \) -mmin "-$STALE_MINUTES" | head -n 1)"
  fi
  if [ -z "$recent" ]; then
    echo "WARNING: backups are on, but there is no backup from the last 2 days in $dir."
    echo "         Check: journalctl -u rechnungen-backup, and that the backup disk is mounted."
  fi
fi
echo

echo "== containers"
compose ps

echo
echo "== disk (docker data)"
docker_root="$(docker info -f '{{.DockerRootDir}}' 2>/dev/null || true)"
if [ -n "$docker_root" ] && [ -d "$docker_root" ]; then
  df -h "$docker_root"
else
  # Docker Desktop keeps its data inside a VM; show the disk of the deploy directory instead.
  df -h "$DEPLOY_DIR"
fi

echo
echo "== newest backup (last successful one)"
latest=""
if [ -d "$dir" ]; then
  # Only finished archives count: the lock file is touched by every run (also a failed one) and .partial.* files are unfinished.
  # rechnungen-<digit>... excludes the safety and pre-update copies (rechnungen-safety-..., rechnungen-preupdate-...). Encrypted (.tar.age) and
  # unencrypted (.tar) backups both count.
  latest="$(find "$dir" -maxdepth 1 -type f \( -name 'rechnungen-[0-9]*.tar.age' -o -name 'rechnungen-[0-9]*.tar' \) -exec ls -t {} + 2>/dev/null | head -n 1 || true)"
fi
if [ -n "$latest" ]; then
  case "$latest" in
    *.age) kind="encrypted" ;;
    *) kind="NOT encrypted" ;;
  esac
  echo "$latest ($(date -r "$latest" '+%Y-%m-%d %H:%M')) - $kind"
else
  echo "none in $dir"
fi
if backups_enabled; then
  if [ -n "$(env_get AGE_RECIPIENT)" ]; then
    echo "new backups: encrypted (AGE_RECIPIENT is set)"
  else
    echo "new backups: NOT encrypted (AGE_RECIPIENT is empty; set a key in .env before backups go to an external disk)"
  fi
fi

# Copies made by restore (never pruned: delete them when no longer needed) and by update while backups are off (the newest two stay).
safety=""
if [ -d "$dir" ]; then
  safety="$(find "$dir" -maxdepth 1 -type f \( -name 'rechnungen-safety-*.tar.age' -o -name 'rechnungen-safety-*.tar' -o -name 'rechnungen-preupdate-*.tar.age' -o -name 'rechnungen-preupdate-*.tar' \) | LC_ALL=C sort)"
fi
if [ -n "$safety" ]; then
  echo
  echo "== safety copies (made before a restore or an update with backups off; not counted above)"
  echo "$safety"
  echo "rechnungen-safety-* are never deleted automatically, rechnungen-preupdate-* keep the newest two."
fi
